# Required to run the live voice pipeline. Not required for `pytest` or
# `python -m app.eval.runner`, which exercise the state engine / safety
# engine / agent graph / RAG without touching any real API.

# Gemini Flash text-mode reasoning + tool calling, and Gemini embeddings for RAG.
GEMINI_API_KEY=

# Google Cloud auth for Speech-to-Text, Text-to-Speech, and Vision (OCR).
# Point this at a service account JSON key with those three APIs enabled.
GOOGLE_APPLICATION_CREDENTIALS=

FRONTEND_ORIGIN=http://localhost:5173
