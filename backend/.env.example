# Required to run the live voice pipeline. Not required for `pytest` or
# `python -m app.eval.runner`, which exercise the state engine / safety
# engine / agent graph / RAG without touching any real API.

# Gemini Flash text-mode reasoning + tool calling, and Gemini embeddings for RAG.
GEMINI_API_KEY=

# Google Cloud auth for Speech-to-Text, Text-to-Speech, and Vision (OCR).
# Point this at a service account JSON key with those three APIs enabled.
GOOGLE_APPLICATION_CREDENTIALS=

FRONTEND_ORIGIN=http://localhost:5173

# Optional. Defaults to a local SQLite file (app_data.db) with zero setup.
# Point this at a real Postgres instance for anything beyond local dev —
# SQLite's single-writer lock is a real correctness/throughput bottleneck
# under genuinely concurrent patients, not just a performance nit.
#
# Local dev Postgres via Docker (avoids colliding with any Postgres already
# installed natively on port 5432 — this project's own dev instance was
# stood up on 5433 for exactly that reason):
#   docker run -d --name pre_visit_postgres -e POSTGRES_PASSWORD=devpassword \
#     -e POSTGRES_DB=pre_visit_voice_agent -p 5433:5432 \
#     -v pre_visit_postgres_data:/var/lib/postgresql/data postgres:16-alpine
#
# DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5433/pre_visit_voice_agent

# Signs the patient access tokens issued by /api/appointments/mock (see
# app/identity.py). Has an insecure dev fallback so local runs/tests never
# fail just because it's unset — but a real deployment MUST set a real
# secret here, or every issued token is forgeable by anyone who reads this
# file's default.
# ACCESS_TOKEN_SECRET=
